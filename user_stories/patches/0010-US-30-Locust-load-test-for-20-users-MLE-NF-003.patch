+"""Load test (US-30, MLE-NF-003): 20 concurrent users.
+
+Pass criteria, checked automatically when the run ends (exit code 1 if missed):
+    average response time <= 3 s
+    95th percentile       <= 3 s
+    zero failed requests
+
+A response counts as a failure only if it is unexpected. A 429 "too many jobs" when
+a user presses Train again while their job is still running is the designed
+behaviour (US-39), so it is recorded as a success.
+
+Run (see docs/member2/LOAD_TEST.md):
+    locust -f loadtest/locustfile.py --headless -u 20 -r 5 -t 90s --host http://127.0.0.1:8000
+"""
+import itertools
+import json
+
+from locust import HttpUser, between, events, task
+
+LIMIT_MS = 3000
+PASSWORD = "load-test-pw-123"
+_numbers = itertools.cycle(range(1, 21))
+JSON = {"Content-Type": "application/json"}
+
+
+class Student(HttpUser):
+    wait_time = between(2, 4)  # about 15-30 requests a minute, below the 60 a minute limit
+
+    def on_start(self):
+        self.name_ = f"load{next(_numbers):02d}"
+        self.last_status_url = None
+        with self.client.post("/dev/login", data=json.dumps({"username": self.name_, "password": PASSWORD}),
+                              headers=JSON, name="login", catch_response=True) as r:
+            if r.status_code != 200:
+                r.failure(f"login failed: {r.status_code}")
+        # Like a browser, remember the CSRF token and send it with every change request.
+        self.client.get("/dev/csrf", name="csrf")
+        self.headers = {**JSON, "X-CSRFToken": self.client.cookies.get("csrftoken", "")}
+
+    @task(5)
+    def list_models(self):
+        self.client.get("/api/models", name="GET /api/models")
+
+    @task(3)
+    def validate_params(self):
+        self.client.post("/api/models/random_forest/params/validate", data=json.dumps({"params": {"n_estimators": 50}}),
+                         headers=self.headers, name="POST /api/models/<key>/params/validate")
+
+    @task(2)
+    def start_training(self):
+        body = {"dataset_id": 1, "target": "label", "model": "random_forest", "params": {"n_estimators": 20}}
+        with self.client.post("/api/train", data=json.dumps(body), headers=self.headers, name="POST /api/train",
+                              catch_response=True) as r:
+            if r.status_code == 202:
+                self.last_status_url = r.json()["status_url"]
+                r.success()
+            elif r.status_code == 429 and r.json().get("error") == "too_many_jobs":
+                r.success()  # designed behaviour: one job at a time for a student
+            else:
+                r.failure(f"unexpected {r.status_code}: {r.text[:100]}")
+
+    @task(4)
+    def check_status(self):
+        if self.last_status_url:
+            self.client.get(self.last_status_url, name="GET /api/train/<id>")
+
+
+@events.quitting.add_listener
+def check_pass_criteria(environment, **_):
+    total = environment.stats.total
+    avg, p95, failed = total.avg_response_time, total.get_response_time_percentile(0.95), total.num_failures
+    ok = avg <= LIMIT_MS and p95 <= LIMIT_MS and failed == 0 and total.num_requests > 0
+    print(f"\nLOAD TEST {'PASSED' if ok else 'FAILED'}: requests={total.num_requests} avg={avg:.0f} ms "
+          f"p95={p95:.0f} ms failures={failed} (limit {LIMIT_MS} ms, 0 failures)")
+    environment.process_exit_code = 0 if ok else 1
