+"""Create the 20 load-test users and give each a small CSV dataset (US-30).
+
+Run from the repository root (after `python member2_dev/manage.py migrate`):
+    python loadtest/seed.py
+"""
+import os
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+os.environ.setdefault("DJANGO_SETTINGS_MODULE", "member2_dev.settings")
+
+import django  # noqa: E402
+
+django.setup()
+
+import numpy as np  # noqa: E402
+import pandas as pd  # noqa: E402
+from django.conf import settings  # noqa: E402
+from django.contrib.auth import get_user_model  # noqa: E402
+
+USERS = 20
+PASSWORD = "load-test-pw-123"
+
+
+def sample(seed):
+    rng = np.random.default_rng(seed)
+    frames = []
+    for i, label in enumerate(["a", "b", "c"]):
+        frames.append(pd.DataFrame({"x1": rng.normal(i * 2, 1, 200), "x2": rng.normal(-i, 1, 200),
+                                    "colour": rng.choice(["red", "green", "blue"], 200), "label": label}))
+    return pd.concat(frames, ignore_index=True)
+
+
+def main():
+    User = get_user_model()
+    for n in range(1, USERS + 1):
+        user, _ = User.objects.get_or_create(username=f"load{n:02d}")
+        user.set_password(PASSWORD)
+        user.save()
+        folder = Path(settings.WBMME_DATA_ROOT) / str(user.pk)
+        folder.mkdir(parents=True, exist_ok=True)
+        sample(n).to_csv(folder / "1.csv", index=False)
+    print(f"{USERS} users ready (load01..load{USERS:02d}), password {PASSWORD}")
+
+
+if __name__ == "__main__":
+    main()
