+"""US-28 / Test Plan 13: integration tests.
+
+Each test joins several real components (HTTP layer, validation, database, job
+runner, artifact storage, limits) and checks they work together. Training runs
+in a REAL child process here, as it does in production.
+"""
+import json
+import time
+
+import joblib
+import pytest
+from django.contrib.auth.models import Group
+
+from training import artifacts, pipeline
+from training.models import TrainingRun
+
+pytestmark = [pytest.mark.req("MLE-F-007", "MLE-F-008", "MLE-F-009", "MLE-NF-006", "MLE-SR-006")]
+
+
+@pytest.fixture(autouse=True)
+def real_processes(settings):
+    settings.WBMME_JOB_ISOLATION = True
+    settings.WBMME_JOB_TIMEOUT_SECONDS = 120
+
+
+def post(client, url, body):
+    return client.post(url, data=json.dumps(body), content_type="application/json")
+
+
+def train(client, **over):
+    body = {"dataset_id": 1, "target": "label", "model": "logistic_regression"}
+    body.update(over)
+    return post(client, "/api/train", body)
+
+
+def test_catalogue_defaults_are_accepted_by_validation_and_training(auth_client, dataset):
+    """Catalogue -> params validation -> training request -> job -> artifact, for every model."""
+    for m in auth_client.get("/api/models").json()["models"]:
+        defaults = {p["name"]: p["default"] for p in m["params"]}
+        assert post(auth_client, f"/api/models/{m['key']}/params/validate", {"params": defaults}).status_code == 200
+        r = train(auth_client, model=m["key"], params=defaults)
+        assert r.status_code == 202
+        run = auth_client.get(r.json()["status_url"]).json()
+        assert run["status"] == "completed", (m["key"], run["error"])
+        # a Student may run one job at a time: this one has finished, so the next may start
+
+
+def test_artifact_predicts_on_the_users_own_test_split(auth_client, user, dataset, settings):
+    run_id = train(auth_client, model="random_forest", params={"n_estimators": 20}, seed=3).json()["run_id"]
+    model = joblib.load(artifacts.artifact_path(user.pk, run_id))
+    csv = settings.WBMME_DATA_ROOT / str(user.pk) / "1.csv"
+    _, X_test, _, y_test = pipeline.load_split(csv, "label", 0.2, 3)
+    assert (model.predict(X_test) == y_test).mean() > 0.5  # sample classes overlap; chance level is 0.33
+
+
+def test_invalid_hyperparameter_never_reaches_a_job(auth_client, dataset):
+    r = train(auth_client, model="knn", params={"n_neighbors": 0})
+    assert r.status_code == 400 and TrainingRun.objects.count() == 0
+
+
+def test_two_users_are_fully_separated(client, user, other_user, dataset, settings):
+    from .conftest import write_csv
+    import pandas as pd
+
+    write_csv(settings, other_user.pk, 1, pd.read_csv(settings.WBMME_DATA_ROOT / str(user.pk) / "1.csv"))
+    client.force_login(user)
+    a = train(client).json()["run_id"]
+    client.force_login(other_user)
+    b = train(client).json()["run_id"]
+    assert client.get(f"/api/train/{a}").status_code == 404           # cannot read A's run
+    assert artifacts.artifact_path(user.pk, a).parent != artifacts.artifact_path(other_user.pk, b).parent
+    assert artifacts.artifact_path(user.pk, a).is_file() and artifacts.artifact_path(other_user.pk, b).is_file()
+
+
+def test_failed_job_then_good_job_through_the_api(settings, auth_client, dataset):
+    settings.WBMME_WORKER_ENTRY = "training.tests.faults.crash"
+    bad = auth_client.get(train(auth_client).json()["status_url"]).json()
+    assert bad["status"] == "failed" and "unexpectedly" in bad["error"]
+    settings.WBMME_WORKER_ENTRY = "training.worker.run_job"
+    good = auth_client.get(train(auth_client).json()["status_url"]).json()
+    assert good["status"] == "completed"   # the failed run freed the student's single slot
+
+
+def test_limits_apply_in_front_of_training(settings, auth_client, user, dataset):
+    TrainingRun.objects.create(owner=user, dataset_id=1, target="label", model_key="knn", status="running")
+    assert train(auth_client).status_code == 429
+    user.groups.add(Group.objects.create(name="Data Scientist"))
+    assert train(auth_client).status_code == 202
+
+
+@pytest.mark.django_db(transaction=True)
+def test_real_background_thread_completes_a_job(settings, auth_client, user, dataset):
+    """Without WBMME_JOBS_INLINE the request returns first and the thread finishes the job."""
+    settings.WBMME_JOBS_INLINE = False
+    r = train(auth_client)
+    assert r.status_code == 202
+    deadline = time.monotonic() + 60
+    status = None
+    while time.monotonic() < deadline:
+        status = auth_client.get(r.json()["status_url"]).json()["status"]
+        if status in ("completed", "failed"):
+            break
+        time.sleep(0.3)
+    assert status == "completed"
