+"""US-28 / Test Plan 13: system tests.
+
+Black-box journeys over HTTP only: log in with a username and password, use the
+API, read the result. They touch no internal module except to put a CSV where the
+placeholder dataset storage expects it. Training runs in a real child process.
+"""
+import json
+
+import pytest
+
+pytestmark = pytest.mark.req("MLE-F-007", "MLE-F-008", "MLE-F-009", "MLE-NF-006", "MLE-SR-006")
+
+
+@pytest.fixture(autouse=True)
+def real_processes(settings):
+    settings.WBMME_JOB_ISOLATION = True
+    settings.WBMME_JOB_TIMEOUT_SECONDS = 120
+
+
+def call(client, method, url, body=None):
+    kwargs = {"data": json.dumps(body), "content_type": "application/json"} if body is not None else {}
+    return getattr(client, method)(url, **kwargs)
+
+
+def test_journey_choose_tune_train_and_check(client, user, dataset):
+    """TC-MODEL-01: a student picks a model, tunes it, trains it and sees it finish."""
+    assert call(client, "get", "/api/models").status_code == 401                 # not logged in yet
+    assert call(client, "post", "/dev/login", {"username": "alice", "password": "pw-alice-123"}).status_code == 200
+
+    models = call(client, "get", "/api/models").json()["models"]
+    assert [m["key"] for m in models] == ["logistic_regression", "knn", "decision_tree", "random_forest"]
+
+    bad = call(client, "post", "/api/models/logistic_regression/params/validate", {"params": {"C": 500}})
+    assert bad.status_code == 400 and "C must be a number between 0.01 and 100." in json.dumps(bad.json())
+    ok = call(client, "post", "/api/models/logistic_regression/params/validate", {"params": {"C": 10}})
+    assert ok.status_code == 200
+
+    started = call(client, "post", "/api/train", {"dataset_id": 1, "target": "label", "model": "logistic_regression", "params": {"C": 10}})
+    assert started.status_code == 202
+    done = call(client, "get", started.json()["status_url"]).json()
+    assert done["status"] == "completed" and done["params"]["C"] == 10 and done["duration_seconds"] is not None
+
+
+def test_journey_wrong_password_and_logout(client, user, dataset):
+    assert call(client, "post", "/dev/login", {"username": "alice", "password": "wrong"}).status_code == 401
+    call(client, "post", "/dev/login", {"username": "alice", "password": "pw-alice-123"})
+    assert call(client, "get", "/api/models").status_code == 200
+    call(client, "post", "/dev/logout")
+    assert call(client, "post", "/api/train", {"dataset_id": 1, "target": "label", "model": "knn"}).status_code == 401
+
+
+@pytest.mark.django_db(transaction=True)
+def test_journey_student_double_click_is_stopped_then_allowed(client, user, dataset, settings):
+    """A student starts a job, tries a second at once (refused), and may start another when the first ends."""
+    settings.WBMME_JOBS_INLINE = False
+    settings.WBMME_JOB_ISOLATION = False
+    import threading
+
+    started, release = threading.Event(), threading.Event()
+    from training import worker
+
+    real = worker.pipeline.train
+
+    def slow(*a, **k):
+        started.set()
+        release.wait(30)
+        return real(*a, **k)
+
+    worker.pipeline.train = slow
+    try:
+        client.force_login(user)
+        body = {"dataset_id": 1, "target": "label", "model": "knn"}
+        first = call(client, "post", "/api/train", body)
+        assert first.status_code == 202 and started.wait(30)
+        assert call(client, "get", first.json()["status_url"]).json()["status"] == "running"
+        second = call(client, "post", "/api/train", body)
+        assert second.status_code == 429 and second.json()["error"] == "too_many_jobs"
+        release.set()
+        import time
+        deadline = time.monotonic() + 60
+        while time.monotonic() < deadline and call(client, "get", first.json()["status_url"]).json()["status"] != "completed":
+            time.sleep(0.2)
+        third = call(client, "post", "/api/train", body)
+        assert third.status_code == 202
+        while time.monotonic() < deadline and call(client, "get", third.json()["status_url"]).json()["status"] != "completed":
+            time.sleep(0.2)  # let the last job finish before the test database is removed
+    finally:
+        worker.pipeline.train = real
+        release.set()
+
+
+def test_journey_hostile_requests_get_clean_errors(client, user, dataset):
+    client.force_login(user)
+    for body in (b"{", b"[]", b"null", b'{"dataset_id": "1; DROP TABLE"}'):
+        r = client.post("/api/train", data=body, content_type="application/json")
+        assert r.status_code == 400 and r.json()["error"] in ("bad_request", "invalid_request")
+    assert client.get("/api/train/abc").status_code == 404
+    assert client.delete("/api/train").status_code == 405
