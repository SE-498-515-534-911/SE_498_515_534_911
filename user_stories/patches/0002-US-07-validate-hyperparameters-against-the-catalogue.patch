+import json
+
+import pytest
+
+pytestmark = [pytest.mark.req("MLE-F-008"), pytest.mark.django_db]
+
+
+def post(client, key, payload):
+    return client.post(f"/api/models/{key}/params/validate", data=json.dumps(payload), content_type="application/json")
+
+
+def test_requires_login(client):
+    assert post(client, "knn", {"params": {}}).status_code == 401
+
+
+def test_valid_params_return_the_complete_set(auth_client):
+    response = post(auth_client, "logistic_regression", {"params": {"C": 2.5}})
+    assert response.status_code == 200
+    assert response.json() == {"valid": True, "model": "logistic_regression", "params": {"C": 2.5, "max_iter": 200}}
+
+
+def test_negative_c_is_refused_with_a_message_naming_the_parameter(auth_client):
+    response = post(auth_client, "logistic_regression", {"params": {"C": -5}})
+    assert response.status_code == 400
+    body = response.json()
+    assert body["error"] == "invalid_params"
+    assert body["details"] == [{"field": "params.C", "message": "C must be a number between 0.01 and 100."}]
+
+
+def test_unknown_model_is_404(auth_client):
+    response = post(auth_client, "svm", {"params": {}})
+    assert response.status_code == 404
+    assert response.json()["error"] == "unknown_model"
+
+
+def test_malformed_json_is_400(auth_client):
+    response = auth_client.post("/api/models/knn/params/validate", data="{not json", content_type="application/json")
+    assert response.status_code == 400
+    assert response.json()["error"] == "bad_request"
+
+
+def test_get_is_not_allowed(auth_client):
+    assert auth_client.get("/api/models/knn/params/validate").status_code == 405
