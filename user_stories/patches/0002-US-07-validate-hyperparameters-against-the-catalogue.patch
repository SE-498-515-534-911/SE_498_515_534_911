@@ -11,3 +12,26 @@ from .http import api_login_required
 def list_models(request):
     """GET /api/models: the model catalogue with defaults and permitted ranges (MLE-F-007)."""
     return JsonResponse({"models": [m.describe() for m in catalogue.list_models()]})
+
+
+@require_POST
+@api_login_required
+def validate_model_params(request, key):
+    """POST /api/models/<key>/params/validate: check hyperparameters before training (MLE-F-008).
+
+    Body: {"params": {...}}. Returns 200 with the complete parameter set (defaults filled in),
+    or 400 listing every problem with the parameter name and its permitted range.
+    """
+    try:
+        catalogue.get_model(key)
+    except catalogue.UnknownModel:
+        return error_response(404, "unknown_model", f"There is no model called '{key}' in the catalogue.")
+    try:
+        body = parse_json_object(request)
+    except BadJson as exc:
+        return error_response(400, "bad_request", str(exc))
+    clean, errors = validate_params(key, body.get("params"))
+    if errors:
+        return error_response(400, "invalid_params", "Some settings are outside their permitted range.",
+                              [e.as_dict() for e in errors])
+    return JsonResponse({"valid": True, "model": key, "params": clean})
