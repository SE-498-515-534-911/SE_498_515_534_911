index 0000000..c468001
--- /dev/null
+++ b/training/runner.py
@@ -0,0 +1,103 @@
+"""Runs one training job and contains whatever goes wrong with it (US-21, MLE-NF-006).
+
+With isolation on (the default), the job runs in a freshly started Python process
+("spawn", so it works on Windows too and shares nothing with the web server). The
+web server only waits for it, with a time limit, and reads its small result file.
+So these all fail ONE run and leave the server and other users' jobs untouched:
+
+* an exception inside training            -> reported in result.json
+* a crash or kill (e.g. out of memory)    -> process ends with no result file
+* a job that never finishes               -> killed after the time limit
+
+`JobFailed.message` is always safe to show the user. Technical detail goes to the log.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import multiprocessing
+from pathlib import Path
+
+from django.conf import settings
+from django.utils.module_loading import import_string
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_ENTRY = "training.worker.run_job"
+DEFAULT_TIMEOUT_SECONDS = 300
+
+CRASH_MESSAGE = (
+    "Training stopped unexpectedly. The dataset or model may be too large for the server. "
+    "Try a smaller dataset or a simpler model."
+)
+INTERNAL_MESSAGE = "Training failed because of an internal error. Please try again, and tell your administrator if it keeps happening."
+
+
+class JobFailed(Exception):
+    def __init__(self, message: str):
+        super().__init__(message)
+        self.message = message
+
+
+def timeout_seconds() -> float:
+    return float(getattr(settings, "WBMME_JOB_TIMEOUT_SECONDS", DEFAULT_TIMEOUT_SECONDS))
+
+
+def _entry():
+    return import_string(getattr(settings, "WBMME_WORKER_ENTRY", DEFAULT_ENTRY))
+
+
+def _read_result(work_dir: Path) -> dict | None:
+    try:
+        return json.loads((work_dir / "result.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+
+
+def _run_in_new_process(entry, spec: dict, limit: float) -> int | None:
+    """Start the job process and wait. Returns its exit code, or None if it had to be killed."""
+    proc = multiprocessing.get_context("spawn").Process(target=entry, args=(spec,), daemon=True)
+    proc.start()
+    try:
+        proc.join(limit)
+        if proc.is_alive():
+            proc.kill()
+            proc.join(10)
+            return None
+        return proc.exitcode
+    finally:
+        if proc.is_alive():  # pragma: no cover (defensive: never leave a stray process behind)
+            proc.kill()
+
+
+def run(spec: dict) -> dict:
+    """Run a job; return its `info` dict on success, raise JobFailed otherwise."""
+    work_dir = Path(spec["out_dir"])
+    entry = _entry()
+    if getattr(settings, "WBMME_JOB_ISOLATION", True):
+        limit = timeout_seconds()
+        exit_code = _run_in_new_process(entry, spec, limit)
+        if exit_code is None:
+            logger.warning("Training job %s killed after %s seconds", work_dir.name, limit)
+            raise JobFailed(f"Training took longer than {int(limit)} seconds and was stopped.")
+    else:
+        try:
+            entry(spec)
+        except BaseException:  # noqa: BLE001  (a custom entry that raises is an internal error)
+            logger.exception("Training job %s raised", work_dir.name)
+            raise JobFailed(INTERNAL_MESSAGE) from None
+        exit_code = 0
+
+    result = _read_result(work_dir)
+    if result is None:
+        logger.error("Training job %s ended (exit code %s) without a result", work_dir.name, exit_code)
+        raise JobFailed(CRASH_MESSAGE)
+    if result.get("ok"):
+        if not (work_dir / "model.joblib").is_file():
+            logger.error("Training job %s reported success but wrote no model", work_dir.name)
+            raise JobFailed(INTERNAL_MESSAGE)
+        return result.get("info", {})
+    if result.get("kind") == "data":
+        raise JobFailed(str(result.get("message") or INTERNAL_MESSAGE))
+    logger.error("Training job %s failed:\n%s", work_dir.name, result.get("log", "(no log)"))
+    raise JobFailed(INTERNAL_MESSAGE)
