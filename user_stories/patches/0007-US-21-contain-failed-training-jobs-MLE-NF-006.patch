+def fail_if_stale(run: TrainingRun) -> TrainingRun:
+    """Mark a run Failed if it is still Queued/Running long after it could have finished.
+
+    This covers a server restart or a killed worker thread, which would otherwise leave the
+    run "Running" for ever. Called when a run's status is read.
+    """
+    if run.status not in TrainingRun.ACTIVE_STATUSES:
+        return run
+    limit = timedelta(seconds=runner.timeout_seconds() + STALE_GRACE_SECONDS)
+    if timezone.now() - run.created_at > limit:
+        _finish(run, TrainingRun.Status.FAILED, INTERRUPTED)
+    return run
