+"""The code that actually trains a model (US-21, MLE-NF-006).
+
+`run_job` runs either in a separate process (the normal case) or in the server
+process (WBMME_JOB_ISOLATION = False, used by fast tests). It never imports Django
+and never raises: whatever happens, it leaves a small `result.json` in the job's
+work folder, and a `model.joblib` next to it only when training succeeded.
+
+result.json
+    {"ok": true,  "info": {...}}
+    {"ok": false, "kind": "data",     "message": "<text safe to show the user>"}
+    {"ok": false, "kind": "internal", "log": "<traceback, server log only>"}
+
+The parent decides what the user sees. A process that dies without writing
+result.json (killed, out of memory, crash) is detected by the parent.
+"""
+from __future__ import annotations
+
+import json
+import os
+import traceback
+from pathlib import Path
+
+from . import pipeline
+
+
+def _write_result(out_dir: Path, payload: dict) -> None:
+    temp = out_dir / "result.json.tmp"
+    temp.write_text(json.dumps(payload), encoding="utf-8")
+    os.replace(temp, out_dir / "result.json")
+
+
+def run_job(spec: dict) -> None:
+    """spec: csv_path, target, model_key, params, test_size, seed, out_dir (all plain values)."""
+    out_dir = Path(spec["out_dir"])
+    try:
+        import joblib
+
+        result = pipeline.train(
+            spec["csv_path"], spec["target"], spec["model_key"], spec["params"], spec["test_size"], spec["seed"]
+        )
+        joblib.dump(result.pipeline, out_dir / "model.joblib")
+        _write_result(out_dir, {"ok": True, "info": result.info})
+    except pipeline.DataError as exc:
+        _write_result(out_dir, {"ok": False, "kind": "data", "message": str(exc)})
+    except BaseException:  # noqa: BLE001  (MemoryError and friends: record, never crash the parent)
+        _write_result(out_dir, {"ok": False, "kind": "internal", "log": traceback.format_exc()})
