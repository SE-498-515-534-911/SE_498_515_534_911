 from django.conf import settings
@@ -40,3 +41,23 @@ def save(obj, user_id: int, run_id: int) -> Path:
     finally:
         temp.unlink(missing_ok=True)
     return final
+
+
+def work_dir(user_id: int, run_id: int) -> Path:
+    """A private scratch folder for one job. The job process writes here, never into the final location."""
+    path = user_dir(user_id, create=True) / f".work_run_{int(run_id)}"
+    if path.exists():
+        shutil.rmtree(path, ignore_errors=True)
+    path.mkdir()
+    return path
+
+
+def promote(model_file: Path, user_id: int, run_id: int) -> Path:
+    """Move a finished model into its final place in one atomic step. Only called after success."""
+    final = artifact_path(user_id, run_id)
+    os.replace(model_file, final)
+    return final
+
+
+def discard(path: Path) -> None:
+    shutil.rmtree(path, ignore_errors=True)
