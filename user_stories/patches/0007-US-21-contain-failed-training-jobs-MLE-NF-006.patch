+"""Fault-injection worker entries for the containment tests (US-21).
+
+They are plugged in through the WBMME_WORKER_ENTRY setting and run in the child
+process, so each one reproduces a way a real training job can die.
+"""
+import os
+import time
+from pathlib import Path
+
+from training import pipeline, worker
+
+
+def crash(spec):
+    """Dies at once with no result, like a process killed for using too much memory."""
+    os._exit(137)
+
+
+def hang(spec):
+    """Never finishes."""
+    time.sleep(600)
+
+
+def raises(spec):
+    """Raises before the worker's own error handling is reached."""
+    raise RuntimeError("secret internal detail /srv/app/secret.csv")
+
+
+def memory_error(spec):
+    """The real worker, but training runs out of memory."""
+    def boom(*a, **k):
+        raise MemoryError("secret allocation detail")
+
+    pipeline.train = boom
+    worker.run_job(spec)
+
+
+def partial_then_crash(spec):
+    """Writes half a model file, then dies."""
+    (Path(spec["out_dir"]) / "model.joblib").write_bytes(b"half a model")
+    os._exit(1)
+
+
+def success_without_model(spec):
+    """Claims success but wrote no model."""
+    worker._write_result(Path(spec["out_dir"]), {"ok": True, "info": {}})
