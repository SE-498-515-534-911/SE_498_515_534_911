diff --git a/training/tests/test_containment.py b/training/tests/test_containment.py
new file mode 100644
index 0000000..1798259
--- /dev/null
+++ b/training/tests/test_containment.py
@@ -0,0 +1,167 @@
+"""US-21 / MLE-NF-006: a failed job is contained.
+
+These tests start REAL child processes (WBMME_JOB_ISOLATION = True), so each takes
+a moment. Every fault must (1) fail only that run, (2) show a safe message,
+(3) leave no model file or scratch folder behind and (4) leave the server able to
+run the next job.
+"""
+import json
+import time
+from datetime import timedelta
+
+import pytest
+from django.utils import timezone
+
+from training import artifacts, jobs, runner
+from training.models import TrainingRun
+
+pytestmark = pytest.mark.req("MLE-NF-006")
+
+FAULTS = "training.tests.faults."
+
+
+@pytest.fixture(autouse=True)
+def isolated(settings):
+    settings.WBMME_JOB_ISOLATION = True
+    settings.WBMME_JOB_TIMEOUT_SECONDS = 60
+
+
+def new_run(user, dataset, **kw):
+    fields = dict(owner=user, dataset_id=dataset, target="label", model_key="decision_tree", params={})
+    fields.update(kw)
+    return TrainingRun.objects.create(**fields)
+
+
+def run_job(user, dataset, **kw):
+    run = new_run(user, dataset, **kw)
+    jobs.execute_run(run.pk)
+    run.refresh_from_db()
+    return run
+
+
+def assert_clean(user, run):
+    """No model and no scratch folder after a failure."""
+    assert not artifacts.artifact_path(user.pk, run.pk).exists()
+    assert not list(artifacts.user_dir(user.pk).glob(".work_run_*"))
+
+
+def test_real_training_in_a_separate_process(user, dataset):
+    import joblib
+
+    run = run_job(user, dataset)
+    assert run.status == "completed", run.error_message
+    assert hasattr(joblib.load(artifacts.artifact_path(user.pk, run.pk)), "predict")
+    assert not list(artifacts.user_dir(user.pk).glob(".work_run_*"))
+
+
+def test_data_problem_in_child_gives_friendly_message(user, dataset):
+    run = run_job(user, dataset, target="nope")
+    assert run.status == "failed" and "not in the dataset" in run.error_message
+    assert_clean(user, run)
+
+
+@pytest.mark.parametrize("entry", ["crash", "raises", "partial_then_crash"])
+def test_crash_is_contained(settings, user, dataset, entry):
+    settings.WBMME_WORKER_ENTRY = FAULTS + entry
+    run = run_job(user, dataset)
+    assert run.status == "failed"
+    assert run.error_message == runner.CRASH_MESSAGE
+    assert "secret" not in run.error_message and "/srv" not in run.error_message
+    assert run.finished_at is not None
+    assert_clean(user, run)
+
+
+def test_memory_error_is_contained_and_hidden(settings, user, dataset, caplog):
+    settings.WBMME_WORKER_ENTRY = FAULTS + "memory_error"
+    run = run_job(user, dataset)
+    assert run.status == "failed" and run.error_message == runner.INTERNAL_MESSAGE
+    assert "secret" not in run.error_message
+    assert "MemoryError" in caplog.text  # the detail is in the server log
+    assert_clean(user, run)
+
+
+def test_hung_job_is_killed_at_the_time_limit(settings, user, dataset):
+    settings.WBMME_WORKER_ENTRY = FAULTS + "hang"
+    settings.WBMME_JOB_TIMEOUT_SECONDS = 2
+    start = time.monotonic()
+    run = run_job(user, dataset)
+    assert time.monotonic() - start < 30
+    assert run.status == "failed"
+    assert run.error_message == "Training took longer than 2 seconds and was stopped."
+    assert_clean(user, run)
+
+
+def test_success_without_model_is_a_failure(settings, user, dataset):
+    settings.WBMME_WORKER_ENTRY = FAULTS + "success_without_model"
+    run = run_job(user, dataset)
+    assert run.status == "failed" and run.error_message == runner.INTERNAL_MESSAGE
+
+
+def test_next_job_still_works_after_a_crash(settings, user, dataset):
+    settings.WBMME_WORKER_ENTRY = FAULTS + "crash"
+    assert run_job(user, dataset).status == "failed"
+    settings.WBMME_WORKER_ENTRY = runner.DEFAULT_ENTRY
+    assert run_job(user, dataset).status == "completed"
+
+
+def test_one_users_crash_does_not_touch_anothers_run(settings, user, other_user, dataset):
+
+    ok = run_job(user, dataset)
+    settings.WBMME_WORKER_ENTRY = FAULTS + "crash"
+    bad = run_job(user, dataset)
+    assert (ok.status, bad.status) == ("completed", "failed")
+    assert artifacts.artifact_path(user.pk, ok.pk).is_file()  # the earlier model is untouched
+
+
+def test_crash_through_the_api_returns_a_normal_response(settings, auth_client, dataset):
+    settings.WBMME_WORKER_ENTRY = FAULTS + "crash"
+    r = auth_client.post("/api/train", data=json.dumps({"dataset_id": 1, "target": "label", "model": "knn"}),
+                         content_type="application/json")
+    assert r.status_code == 202
+    status = auth_client.get(r.json()["status_url"]).json()
+    assert status["status"] == "failed" and status["error"] == runner.CRASH_MESSAGE
+
+
+# --- in-process mode and stale runs -------------------------------------------------
+
+def test_in_process_mode_contains_a_raising_entry(settings, user, dataset):
+    settings.WBMME_JOB_ISOLATION = False
+    settings.WBMME_WORKER_ENTRY = FAULTS + "raises"
+    run = run_job(user, dataset)
+    assert run.status == "failed" and run.error_message == runner.INTERNAL_MESSAGE
+
+
+def test_stale_active_run_is_failed_when_read(settings, user):
+    run = new_run(user, 1, status="running")
+    TrainingRun.objects.filter(pk=run.pk).update(created_at=timezone.now() - timedelta(seconds=60 + jobs.STALE_GRACE_SECONDS + 5))
+    run.refresh_from_db()
+    assert jobs.fail_if_stale(run).status == "failed"
+    assert run.error_message == jobs.INTERRUPTED
+
+
+def test_recent_and_finished_runs_are_left_alone(user):
+    fresh = new_run(user, 1, status="running")
+    done = new_run(user, 1, status="completed")
+    TrainingRun.objects.filter(pk=done.pk).update(created_at=timezone.now() - timedelta(days=3))
+    done.refresh_from_db()
+    assert jobs.fail_if_stale(fresh).status == "running"
+    assert jobs.fail_if_stale(done).status == "completed"
+
+
+def test_failure_while_storing_the_model_is_contained(user, dataset, monkeypatch, settings):
+    settings.WBMME_JOB_ISOLATION = False
+
+    def disk_full(*a, **k):
+        raise OSError("No space left on device: /srv/secret")
+
+    monkeypatch.setattr(artifacts, "promote", disk_full)
+    run = run_job(user, dataset)
+    assert run.status == "failed" and run.error_message == jobs.GENERIC_FAILURE
+    assert_clean(user, run)
+
+
+def test_leftover_work_folder_is_replaced(user):
+    old = artifacts.work_dir(user.pk, 3)
