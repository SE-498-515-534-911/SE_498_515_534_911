@@ -0,0 +1,234 @@
+"""US-39 / MLE-SR-006: request limits, job limits and the job time-out."""
+import json
+
+import pytest
+from django.contrib.auth import get_user_model
+from django.contrib.auth.models import Group
+from django.test import RequestFactory
+
+from training import quota, ratelimit, runner, views
+from training.middleware import (DEFAULT_MAX_REQUEST_BYTES, DEFAULT_RATE_LIMIT_PER_MINUTE,
+                                 RequestLimitsMiddleware)
+from training.models import TrainingRun
+
+pytestmark = pytest.mark.req("MLE-SR-006")
+
+TRAIN = "/api/train"
+GOOD = {"dataset_id": 1, "target": "label", "model": "knn"}
+
+
+def post(client, body=GOOD, url=TRAIN, **extra):
+    data = body if isinstance(body, (str, bytes)) else json.dumps(body)
+    return client.post(url, data=data, content_type="application/json", **extra)
+
+
+# --- rate limit ---------------------------------------------------------------------
+
+class TestRateLimiter:
+    def test_allows_up_to_the_limit_then_refuses(self, clock):
+        assert [ratelimit.check("k", 3)[0] for _ in range(4)] == [True, True, True, False]
+
+    def test_retry_after_counts_down_to_the_oldest_request(self, clock):
+        for _ in range(3):
+            ratelimit.check("k", 3)
+        clock.t += 20
+        allowed, retry = ratelimit.check("k", 3)
+        assert not allowed and retry == 40
+
+    def test_window_slides(self, clock):
+        ratelimit.check("k", 3)          # t = 0
+        clock.t += 30
+        ratelimit.check("k", 3)          # t = 30
+        clock.t += 29
+        ratelimit.check("k", 3)          # t = 59
+        assert not ratelimit.check("k", 3)[0]
+        clock.t += 2                     # t = 61: the first request has left the window, the others have not
+        assert ratelimit.check("k", 3)[0]
+        assert not ratelimit.check("k", 3)[0]
+
+    def test_no_double_burst_across_a_minute_boundary(self, clock):
+        """A fixed per-minute counter would allow 2 x limit around the boundary; a sliding window does not."""
+        clock.t = 1_000_000.0 - 1.0 + 60 - 0.5  # half a second before a whole minute
+        results = [ratelimit.check("k", 3)[0] for _ in range(3)]
+        clock.t += 1.0                  # just after the boundary
+        results += [ratelimit.check("k", 3)[0] for _ in range(3)]
+        assert results == [True] * 3 + [False] * 3
+
+    def test_refused_requests_are_not_counted(self, clock):
+        for _ in range(3):
+            ratelimit.check("k", 3)
+        for _ in range(50):
+            assert not ratelimit.check("k", 3)[0]
+        clock.t += 61
+        assert ratelimit.check("k", 3)[0]
+
+    def test_keys_are_independent(self, clock):
+        for _ in range(3):
+            ratelimit.check("a", 3)
+        assert not ratelimit.check("a", 3)[0]
+        assert ratelimit.check("b", 3)[0]
+
+
+class TestRateLimitMiddleware:
+    def test_default_is_sixty_per_minute(self):
+        assert DEFAULT_RATE_LIMIT_PER_MINUTE == 60
+
+    def test_429_with_retry_after_header(self, settings, auth_client, clock):
+        settings.WBMME_RATE_LIMIT_PER_MINUTE = 3
+        codes = [auth_client.get("/api/models").status_code for _ in range(4)]
+        assert codes == [200, 200, 200, 429]
+        r = auth_client.get("/api/models")
+        assert r.json()["error"] == "rate_limited"
+        assert r["Retry-After"] == "60"
+        assert "60 seconds" in r.json()["message"]
+
+    def test_allowed_again_after_the_window(self, settings, auth_client, clock):
+        settings.WBMME_RATE_LIMIT_PER_MINUTE = 2
+        auth_client.get("/api/models"), auth_client.get("/api/models")
+        assert auth_client.get("/api/models").status_code == 429
+        clock.t += 61
+        assert auth_client.get("/api/models").status_code == 200
+
+    def test_limit_is_per_user(self, settings, client, user, other_user, clock):
+        settings.WBMME_RATE_LIMIT_PER_MINUTE = 1
+        client.force_login(user)
+        client.get("/api/models")
+        assert client.get("/api/models").status_code == 429
+        client.force_login(other_user)
+        assert client.get("/api/models").status_code == 200
+
+    def test_anonymous_clients_are_limited_by_address(self, settings, client, clock):
+        settings.WBMME_RATE_LIMIT_PER_MINUTE = 2
+        codes = [client.get("/api/models").status_code for _ in range(3)]
+        assert codes == [401, 401, 429]
+
+    def test_other_paths_are_not_limited(self, settings, client, clock):
+        settings.WBMME_RATE_LIMIT_PER_MINUTE = 1
+        assert all(client.get("/dev/logout").status_code != 429 for _ in range(3))
+
+
+# --- request size -------------------------------------------------------------------
+
+class TestRequestSize:
+    def test_default_is_ten_megabytes(self):
+        assert DEFAULT_MAX_REQUEST_BYTES == 10 * 1024 * 1024
+
+    def test_too_large_gets_413_before_anything_else(self, settings, client):
+        settings.WBMME_MAX_REQUEST_BYTES = 1000
+        r = post(client, b" " * 1001)  # not even logged in: size is checked first
+        assert r.status_code == 413
+        assert r.json()["error"] == "request_too_large"
+
+    def test_message_names_the_limit(self, settings, client):
+        r = post(client, b" " * (DEFAULT_MAX_REQUEST_BYTES + 1))
+        assert r.status_code == 413 and "10 MB" in r.json()["message"]
+
+    def test_exactly_at_the_limit_is_accepted(self, settings, auth_client, dataset):
+        body = json.dumps(GOOD)
+        settings.WBMME_MAX_REQUEST_BYTES = len(body)
+        assert post(auth_client, body).status_code == 202
+
+    def test_one_byte_over_is_refused(self, settings, auth_client, dataset):
+        body = json.dumps(GOOD)
+        settings.WBMME_MAX_REQUEST_BYTES = len(body) - 1
+        assert post(auth_client, body).status_code == 413
+
+    def test_bad_content_length_header(self, auth_client):
+        assert auth_client.generic("POST", TRAIN, "{}", "application/json", CONTENT_LENGTH="abc").status_code == 400
+        assert auth_client.generic("POST", TRAIN, "{}", "application/json", CONTENT_LENGTH="-5").status_code == 400
+
+    def test_body_of_unknown_length_is_refused(self, auth_client):
+        r = auth_client.generic("POST", TRAIN, "{}", "application/json", CONTENT_LENGTH="", HTTP_TRANSFER_ENCODING="chunked")
+        assert r.status_code == 411
+
+    def test_get_without_a_body_is_fine(self, auth_client):
+        assert auth_client.get("/api/models").status_code == 200
+
+    def test_view_itself_returns_413_if_django_refuses_the_body(self, settings, user):
+        """Second line of defence: DATA_UPLOAD_MAX_MEMORY_SIZE, if the middleware is not installed."""
+        settings.DATA_UPLOAD_MAX_MEMORY_SIZE = 10
+        req = RequestFactory().post(TRAIN, data=json.dumps(GOOD), content_type="application/json")
+        req.user = user
+        assert views.start_training(req).status_code == 413
+
+
+# --- job quota ----------------------------------------------------------------------
+
+def active_run(user, status="running"):
+    return TrainingRun.objects.create(owner=user, dataset_id=1, target="label", model_key="knn", status=status)
+
+
+class TestJobQuota:
+    def test_table(self):
+        assert quota.QUOTA_BY_ROLE == {"student": 1, "data_scientist": 2, "admin": 2}
+
+    def test_default_roles(self, user, other_user):
+        assert quota.role_of(user) == "student"
+        other_user.groups.add(Group.objects.create(name="Data Scientist"))
+        assert quota.role_of(other_user) == "data_scientist"
+        other_user.is_staff = True
+        assert quota.role_of(other_user) == "admin"
+
+    def test_student_may_run_one_job(self, auth_client, user, dataset):
+        active_run(user)
+        r = post(auth_client)
+        assert r.status_code == 429 and r.json()["error"] == "too_many_jobs"
+        assert "1 training job at a time" in r.json()["message"]
+        assert TrainingRun.objects.count() == 1  # nothing new was created
+
+    def test_queued_jobs_count_too(self, auth_client, user, dataset):
+        active_run(user, "queued")
+        assert post(auth_client).status_code == 429
+
+    def test_data_scientist_may_run_two(self, auth_client, user, dataset):
+        user.groups.add(Group.objects.create(name="Data Scientist"))
+        active_run(user)
+        assert post(auth_client).status_code == 202   # second job
+        active_run(user)
+        r = post(auth_client)                          # third job (two now active)
+        assert r.status_code == 429 and "2 training jobs at a time" in r.json()["message"]
+
+    def test_finished_jobs_do_not_count(self, auth_client, user, dataset):
+        active_run(user, "completed")
+        active_run(user, "failed")
+        assert post(auth_client).status_code == 202
+
+    def test_slot_frees_when_the_job_ends(self, auth_client, user, dataset):
+        run = active_run(user)
+        assert post(auth_client).status_code == 429
+        run.status = "completed"
+        run.save()
+        assert post(auth_client).status_code == 202
+
+    def test_other_users_jobs_do_not_count(self, auth_client, other_user, dataset):
+        active_run(other_user)
+        assert post(auth_client).status_code == 202
+
+    def test_unknown_role_gets_the_lowest_quota(self, settings, auth_client, user, dataset):
+        settings.WBMME_ROLE_GETTER = "training.tests.test_limits.mystery_role"
+        assert quota.max_active_jobs(user) == 1
+
+    def test_role_getter_is_replaceable(self, settings, auth_client, user, dataset):
+        settings.WBMME_ROLE_GETTER = "training.tests.test_limits.data_scientist_role"
+        active_run(user)
+        assert post(auth_client).status_code == 202
+
+
+def mystery_role(user):
+    return "visitor"
+
+
+def data_scientist_role(user):
+    return "data_scientist"
+
+
+# --- job time-out -------------------------------------------------------------------
+
