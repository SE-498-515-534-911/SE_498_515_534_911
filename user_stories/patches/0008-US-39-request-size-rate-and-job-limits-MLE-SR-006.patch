@@ -0,0 +1,77 @@
+"""Request-size and rate limits for the API (US-39, MLE-SR-006).
+
+Add to MIDDLEWARE AFTER AuthenticationMiddleware:
+
+    "training.middleware.RequestLimitsMiddleware",
+
+Checks, in this order, for every request whose path starts with WBMME_LIMITED_PREFIX
+(default "/api/"):
+
+1. Body too large   -> 413 (before the body is read; default limit 10 MB)
+2. Rate limit       -> 429 with a Retry-After header (default 60 requests per minute per user;
+                        anonymous clients are counted per network address)
+"""
+from __future__ import annotations
+
+from django.conf import settings
+
+from . import ratelimit
+from .http import error_response
+
+DEFAULT_MAX_REQUEST_BYTES = 10 * 1024 * 1024
+DEFAULT_RATE_LIMIT_PER_MINUTE = 60
+BODY_METHODS = {"POST", "PUT", "PATCH"}
+
+
+def max_request_bytes() -> int:
+    return int(getattr(settings, "WBMME_MAX_REQUEST_BYTES", DEFAULT_MAX_REQUEST_BYTES))
+
+
+def rate_limit_per_minute() -> int:
+    return int(getattr(settings, "WBMME_RATE_LIMIT_PER_MINUTE", DEFAULT_RATE_LIMIT_PER_MINUTE))
+
+
+def body_too_large_response():
+    mb = max_request_bytes() / (1024 * 1024)
+    return error_response(413, "request_too_large", f"The request is too large. The limit is {mb:g} MB.")
+
+
+class RequestLimitsMiddleware:
+    def __init__(self, get_response):
+        self.get_response = get_response
+
+    def __call__(self, request):
+        prefix = getattr(settings, "WBMME_LIMITED_PREFIX", "/api/")
+        if request.path.startswith(prefix):
+            refused = self._check_size(request) or self._check_rate(request)
+            if refused is not None:
+                return refused
+        return self.get_response(request)
+
+    @staticmethod
+    def _check_size(request):
+        raw = request.META.get("CONTENT_LENGTH", "")
+        if raw not in ("", None):
+            try:
+                length = int(raw)
+            except ValueError:
+                return error_response(400, "bad_request", "The Content-Length header is not valid.")
+            if length < 0:
+                return error_response(400, "bad_request", "The Content-Length header is not valid.")
+            if length > max_request_bytes():
+                return body_too_large_response()
+        elif request.method in BODY_METHODS and request.META.get("HTTP_TRANSFER_ENCODING"):
+            # A body of unknown length cannot be size-checked before it is read.
+            return error_response(411, "length_required", "Please send a Content-Length header with the request.")
+        return None
+
+    @staticmethod
+    def _check_rate(request):
+        user = getattr(request, "user", None)
+        key = f"user:{user.pk}" if user is not None and user.is_authenticated else f"ip:{request.META.get('REMOTE_ADDR', '?')}"
+        allowed, retry_after = ratelimit.check(key, rate_limit_per_minute())
+        if allowed:
+            return None
+        response = error_response(429, "rate_limited", f"Too many requests. Please wait {retry_after} seconds and try again.")
+        response["Retry-After"] = str(retry_after)
+        return response
