+"""How many training jobs a user may run at once (US-39, MLE-SR-006).
+
+    Student         1
+    Data Scientist  2
+    Admin           2   (not in the SRS table; the same as a Data Scientist)
+
+A role we do not recognise gets the smallest quota.
+
+The role comes from `WBMME_ROLE_GETTER`, a dotted path to `fn(user) -> str` with
+one of: "student", "data_scientist", "admin". The default below works with
+Django's built-in staff flag and a group called "Data Scientist"; Member 3's
+authentication replaces it with the real role lookup (see INTEGRATION.md).
+"""
+from __future__ import annotations
+
+from django.conf import settings
+from django.utils.module_loading import import_string
+
+QUOTA_BY_ROLE = {"student": 1, "data_scientist": 2, "admin": 2}
+LOWEST_QUOTA = 1
+DEFAULT_ROLE_GETTER = "training.quota.default_role"
+
+
+def default_role(user) -> str:
+    if user.is_superuser or user.is_staff:
+        return "admin"
+    if user.groups.filter(name="Data Scientist").exists():
+        return "data_scientist"
+    return "student"
+
+
+def role_of(user) -> str:
+    getter = import_string(getattr(settings, "WBMME_ROLE_GETTER", DEFAULT_ROLE_GETTER))
+    return str(getter(user))
+
+
+def max_active_jobs(user) -> int:
+    return QUOTA_BY_ROLE.get(role_of(user), LOWEST_QUOTA)
diff --git a/training/ratelimit.py b/training/ratelimit.py
new file mode 100644
index 0000000..0cd668a
--- /dev/null
+++ b/training/ratelimit.py
@@ -0,0 +1,43 @@
+"""Sliding-window rate limit (US-39, MLE-SR-006).
+
+A user may make at most `limit` requests in any rolling 60 seconds. The
+timestamps of recent requests are kept in the Django cache, one list per key.
+A sliding window (not a fixed "per clock minute" counter) means a burst cannot
+be doubled by straddling the minute boundary.
+
+The cache is per server process by default. For several server processes, point
+Django's CACHES at a shared cache (for example Redis); nothing here changes.
+"""
+from __future__ import annotations
+
+import math
+import threading
+import time
+
+from django.core.cache import cache
+
+WINDOW_SECONDS = 60
+_lock = threading.Lock()
+
+
+def now() -> float:
+    """The clock. Tests replace this to move time without sleeping."""
+    return time.time()
+
+
+def check(key: str, limit: int, window: float = WINDOW_SECONDS) -> tuple[bool, int]:
+    """Record a request for `key`. Returns (allowed, retry_after_seconds).
+
+    A refused request is NOT recorded, so a client that keeps retrying is let in as
+    soon as its oldest request leaves the window.
+    """
+    cache_key = f"wbmme:rl:{key}"
+    current = now()
+    with _lock:
+        recent = [t for t in cache.get(cache_key, []) if t > current - window]
+        if len(recent) >= limit:
+            cache.set(cache_key, recent, window + 1)
+            return False, max(1, math.ceil(recent[0] + window - current))
+        recent.append(current)
+        cache.set(cache_key, recent, window + 1)
+        return True, 0
