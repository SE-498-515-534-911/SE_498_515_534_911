+"""Trained-model storage.
+
+Artifacts live in per-user directories under WBMME_ARTIFACT_ROOT, which must be
+OUTSIDE the web root so that no artifact can be requested by URL (MLE-SR-004).
+Only paths built here, from integer IDs, are ever written or read.
+"""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from django.conf import settings
+
+
+def user_dir(user_id: int, create: bool = False) -> Path:
+    path = Path(settings.WBMME_ARTIFACT_ROOT) / str(int(user_id))
+    if create:
+        path.mkdir(parents=True, exist_ok=True)
+        try:
+            os.chmod(path, 0o700)
+        except OSError:  # pragma: no cover (e.g. Windows)
+            pass
+    return path
+
+
+def artifact_path(user_id: int, run_id: int) -> Path:
+    return user_dir(user_id) / f"run_{int(run_id)}.joblib"
+
+
+def save(obj, user_id: int, run_id: int) -> Path:
+    """Write the artifact atomically: a half-written file is never visible under its final name."""
+    import joblib
+
+    final = artifact_path(user_id, run_id)
+    user_dir(user_id, create=True)
+    temp = final.with_suffix(".tmp")
+    try:
+        joblib.dump(obj, temp)
+        os.replace(temp, final)
+    finally:
+        temp.unlink(missing_ok=True)
+    return final
