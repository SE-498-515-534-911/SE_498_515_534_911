+
+
+@require_POST
+@api_login_required
+def start_training(request):
+    """POST /api/train: queue a background training job (MLE-F-009).
+
+    Body: {"dataset_id": 1, "target": "species", "model": "logistic_regression",
+           "params": {"C": 1.0}, "test_size": 0.2, "seed": 42}
+    Returns 202 with the run ID. Poll GET /api/train/<run_id> for the status.
+    """
+    try:
+        body = parse_json_object(request)
+    except BadJson as exc:
+        return error_response(400, "bad_request", str(exc))
+    parsed, errors = parse_train_request(body)
+    if errors:
+        return error_response(400, "invalid_request", "The training request has problems.", errors)
+
+    try:
+        locator.locate(request.user.pk, parsed.dataset_id)
+    except locator.DatasetNotFound:
+        # The same answer for "does not exist" and "belongs to someone else" (MLE-SR-005a).
+        return error_response(404, "dataset_not_found", "That dataset was not found.")
+
+    run = TrainingRun.objects.create(
+        owner=request.user,
+        dataset_id=parsed.dataset_id,
+        target=parsed.target,
+        model_key=parsed.model,
+        params=parsed.params,
+        test_size=parsed.test_size,
+        seed=parsed.seed,
+    )
+    jobs.submit(run.pk)
+    run.refresh_from_db()
+    return JsonResponse(
+        {"run_id": run.pk, "status": run.status, "status_url": f"/api/train/{run.pk}"},
+        status=202,
+    )
+
+
+@require_GET
+@api_login_required
+def training_status(request, run_id):
+    """GET /api/train/<run_id>: status of one of the caller's own runs."""
+    run = TrainingRun.objects.filter(pk=run_id, owner=request.user).first()
+    if run is None:
+        return error_response(404, "not_found", "That run was not found.")
+    return JsonResponse(run.as_dict())
