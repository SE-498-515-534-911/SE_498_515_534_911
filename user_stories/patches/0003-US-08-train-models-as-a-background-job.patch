@@ -0,0 +1,72 @@
+"""Validation of the POST /api/train request body (SRS MLE-F-006, MLE-F-007, MLE-F-008)."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from . import catalogue
+from .params import validate_params
+
+DEFAULT_TEST_SIZE = 0.2
+DEFAULT_SEED = 42
+MAX_SEED = 2**31 - 1
+MAX_TARGET_LENGTH = 200
+
+
+@dataclass
+class TrainRequest:
+    dataset_id: int
+    target: str
+    model: str
+    params: dict
+    test_size: float
+    seed: int
+
+
+def _is_int(v) -> bool:
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def _valid_test_size(v) -> bool:
+    """10% to 50% in steps of 5% (MLE-F-006)."""
+    if isinstance(v, bool) or not isinstance(v, (int, float)):
+        return False
+    steps = v * 20
+    return abs(steps - round(steps)) < 1e-9 and 2 <= round(steps) <= 10
+
+
+def parse_train_request(body: dict) -> tuple[TrainRequest | None, list[dict]]:
+    errors: list[dict] = []
+
+    def fail(field: str, message: str):
+        errors.append({"field": field, "message": message})
+
+    dataset_id = body.get("dataset_id")
+    if not _is_int(dataset_id) or dataset_id < 1:
+        fail("dataset_id", "dataset_id must be a whole number of 1 or more.")
+
+    target = body.get("target")
+    if not isinstance(target, str) or not target.strip() or len(target) > MAX_TARGET_LENGTH:
+        fail("target", f"target must be the name of a column (1 to {MAX_TARGET_LENGTH} characters).")
+
+    model = body.get("model")
+    params: dict = {}
+    try:
+        catalogue.get_model(model)
+    except catalogue.UnknownModel:
+        keys = ", ".join(m.key for m in catalogue.list_models())
+        fail("model", f"model must be one of: {keys}.")
+    else:
+        params, param_errors = validate_params(model, body.get("params"))
+        errors.extend(e.as_dict() for e in param_errors)
+
+    test_size = body.get("test_size", DEFAULT_TEST_SIZE)
+    if not _valid_test_size(test_size):
+        fail("test_size", "test_size must be between 0.10 and 0.50 in steps of 0.05.")
+
+    seed = body.get("seed", DEFAULT_SEED)
+    if not _is_int(seed) or not 0 <= seed <= MAX_SEED:
+        fail("seed", f"seed must be a whole number between 0 and {MAX_SEED}.")
+
+    if errors:
+        return None, errors
+    return TrainRequest(dataset_id, target, model, params, float(test_size), seed), []
