+"""Background training jobs (US-08, MLE-F-009).
+
+A request creates a TrainingRun in status Queued and returns at once. A worker
+thread then moves it to Running and finally Completed or Failed, so the user
+interface stays usable while a job runs. Hardening for failures (US-21) and the
+time-out (US-39) build on this module.
+"""
+from __future__ import annotations
+
+import logging
+import threading
+
+from django.conf import settings
+from django.db import close_old_connections
+from django.utils import timezone
+
+from . import artifacts, locator, pipeline
+from .models import TrainingRun
+
+logger = logging.getLogger(__name__)
+
+GENERIC_FAILURE = "Training failed because of an internal error. Please try again, and tell your administrator if it keeps happening."
+
+
+def submit(run_id: int) -> None:
+    """Start a job. With WBMME_JOBS_INLINE = True it runs in the caller (used by tests)."""
+    if getattr(settings, "WBMME_JOBS_INLINE", False):
+        execute_run(run_id)
+        return
+    threading.Thread(target=_thread_main, args=(run_id,), name=f"wbmme-train-{run_id}", daemon=True).start()
+
+
+def _thread_main(run_id: int) -> None:
+    close_old_connections()
+    try:
+        execute_run(run_id)
+    finally:
+        close_old_connections()
+
+
+def _finish(run: TrainingRun, status: str, error: str = "") -> None:
+    run.status = status
+    run.error_message = error
+    run.finished_at = timezone.now()
+    run.save(update_fields=["status", "error_message", "finished_at"])
+
+
+def execute_run(run_id: int) -> None:
+    run = TrainingRun.objects.filter(pk=run_id).first()
+    if run is None:
+        return
+    run.status = TrainingRun.Status.RUNNING
+    run.started_at = timezone.now()
+    run.save(update_fields=["status", "started_at"])
+    try:
+        csv_path = locator.locate(run.owner_id, run.dataset_id)
+        result = pipeline.train(csv_path, run.target, run.model_key, run.params, run.test_size, run.seed)
+        artifacts.save(result.pipeline, run.owner_id, run.pk)
+    except locator.DatasetNotFound:
+        _finish(run, TrainingRun.Status.FAILED, "The dataset could not be found.")
+    except pipeline.DataError as exc:
+        _finish(run, TrainingRun.Status.FAILED, str(exc))
+    except Exception:  # noqa: BLE001  (the real cause goes to the server log, not to the user)
+        logger.exception("Training run %s failed", run_id)
+        _finish(run, TrainingRun.Status.FAILED, GENERIC_FAILURE)
+    else:
+        _finish(run, TrainingRun.Status.COMPLETED)
