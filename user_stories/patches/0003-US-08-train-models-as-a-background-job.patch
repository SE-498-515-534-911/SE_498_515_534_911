@@ -0,0 +1,82 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from training import pipeline
+
+pytestmark = pytest.mark.req("MLE-F-005", "MLE-F-006", "MLE-F-009")
+
+
+def test_trains_every_catalogue_model(iris_like, tmp_path):
+    from training.catalogue import list_models
+
+    path = tmp_path / "d.csv"
+    iris_like.to_csv(path, index=False)
+    for spec in list_models():
+        result = pipeline.train(path, "label", spec.key, spec.defaults(), 0.2, 42)
+        assert result.info["n_train"] + result.info["n_test"] == 120
+        assert result.info["classes"] == ["a", "b", "c"]
+        X, y = pipeline.load_split(path, "label", 0.2, 42)[1], None
+        assert len(result.pipeline.predict(X)) == result.info["n_test"]
+
+
+def test_split_is_stratified_and_repeatable(iris_like):
+    X, y = pipeline.prepare(iris_like, "label")
+    a = pipeline.make_split(X, y, 0.25, 7)
+    b = pipeline.make_split(X, y, 0.25, 7)
+    assert list(a[1].index) == list(b[1].index)
+    assert a[3].value_counts().nunique() == 1  # same count per class in the test split
+
+
+def test_missing_values_are_handled(iris_like, tmp_path):
+    path = tmp_path / "d.csv"
+    iris_like.to_csv(path, index=False)
+    pipeline.train(path, "label", "logistic_regression", {}, 0.2, 1)  # would raise on NaN otherwise
+
+
+def test_rows_with_missing_target_are_dropped(iris_like):
+    iris_like.loc[:4, "label"] = None
+    X, y = pipeline.prepare(iris_like, "label")
+    assert len(y) == 115
+
+
+def test_unknown_target(iris_like):
+    with pytest.raises(pipeline.DataError, match="not in the dataset"):
+        pipeline.prepare(iris_like, "nope")
+
+
+def test_too_few_classes(iris_like):
+    iris_like["label"] = "only"
+    with pytest.raises(pipeline.DataError, match="between 2 and 20"):
+        pipeline.prepare(iris_like, "label")
+
+
+def test_too_many_classes():
+    df = pd.DataFrame({"x": np.arange(60), "label": np.arange(60) % 21})
+    with pytest.raises(pipeline.DataError, match="between 2 and 20"):
+        pipeline.prepare(df, "label")
+
+
+def test_class_with_one_row(iris_like):
+    iris_like.loc[0, "label"] = "rare"
+    with pytest.raises(pipeline.DataError, match="at least 2 rows"):
+        pipeline.prepare(iris_like, "label")
+
+
+def test_no_feature_columns():
+    with pytest.raises(pipeline.DataError, match="at least one feature"):
+        pipeline.prepare(pd.DataFrame({"label": ["a", "b", "a", "b"]}), "label")
+
+
+def test_test_share_too_small():
+    df = pd.DataFrame({"x": range(12), "label": ["a", "b", "c"] * 4})
+    X, y = pipeline.prepare(df, "label")
+    with pytest.raises(pipeline.DataError, match="test share"):
+        pipeline.make_split(X, y, 0.1, 42)
+
+
+def test_unreadable_csv(tmp_path):
+    path = tmp_path / "bad.csv"
+    path.write_bytes(b"")
+    with pytest.raises(pipeline.DataError, match="could not be read"):
+        pipeline.read_csv(path)
