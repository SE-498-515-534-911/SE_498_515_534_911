+++ b/training/pipeline.py
@@ -0,0 +1,126 @@
+"""Data preparation and model fitting (pure Python: no Django imports).
+
+Pipeline stages follow SAD 3.5: read the CSV, prepare features, split, fit.
+
+* Missing values and categories are handled INSIDE a scikit-learn Pipeline, so
+  they are fitted on the training split only and then applied to the test split.
+  This prevents data leakage (SAD risk R4, SRS MLE-F-005).
+* The split is stratified, so class proportions are kept (SRS MLE-F-006).
+* Problems with the user's data raise `DataError`, whose text is written for the
+  user. Anything else is an internal error and is never shown to the user.
+
+Until the Data Workspace stories (US-04, US-05) land, the default treatment is:
+numbers are filled with the median and scaled, text is filled with the most
+frequent value and one-hot encoded (at most 30 categories per column).
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .catalogue import build_estimator
+
+MIN_CLASSES = 2
+MAX_CLASSES = 20
+MAX_ONE_HOT_CATEGORIES = 30
+
+
+class DataError(Exception):
+    """A problem with the user's data. The message is safe to show to the user."""
+
+
+@dataclass
+class TrainResult:
+    pipeline: object
+    info: dict
+
+
+def read_csv(csv_path):
+    import pandas as pd
+
+    try:
+        return pd.read_csv(csv_path)
+    except (UnicodeDecodeError, pd.errors.ParserError, pd.errors.EmptyDataError):
+        raise DataError("The dataset could not be read as a CSV file.") from None
+
+
+def prepare(df, target: str):
+    """Return (X, y) after checking the target column against SRS Table 4.2-1."""
+    import numpy as np
+
+    if target not in df.columns:
+        raise DataError(f"The target column '{target}' is not in the dataset.")
+    df = df.dropna(subset=[target])
+    if df.shape[1] < 2:
+        raise DataError("The dataset needs at least one feature column besides the target.")
+    y = df[target]
+    X = df.drop(columns=[target]).replace([np.inf, -np.inf], np.nan)
+
+    n_classes = y.nunique()
+    if not MIN_CLASSES <= n_classes <= MAX_CLASSES:
+        raise DataError(
+            f"The target column must have between {MIN_CLASSES} and {MAX_CLASSES} different values; it has {n_classes}."
+        )
+    counts = y.value_counts()
+    if counts.min() < 2:
+        rare = counts.idxmin()
+        raise DataError(f"Every target value needs at least 2 rows, but '{rare}' appears only once.")
+    return X, y
+
+
+def make_split(X, y, test_size: float, seed: int):
+    """Stratified train/test split. Deterministic for a given (test_size, seed)."""
+    from sklearn.model_selection import train_test_split
+
+    try:
+        return train_test_split(X, y, test_size=test_size, random_state=seed, stratify=y)
+    except ValueError:
+        raise DataError(
+            "The test share is too small for the number of target values. "
+            "Choose a larger test share or use a dataset with more rows."
+        ) from None
+
+
+def build_pipeline(model_key: str, params: dict, seed: int, X_train):
+    from sklearn.compose import ColumnTransformer
+    from sklearn.impute import SimpleImputer
+    from sklearn.pipeline import Pipeline
+    from sklearn.preprocessing import OneHotEncoder, StandardScaler
+
+    numeric = list(X_train.select_dtypes(include="number").columns)
+    other = [c for c in X_train.columns if c not in numeric]
+    transformers = []
+    if numeric:
+        transformers.append(("numeric", Pipeline([("fill", SimpleImputer(strategy="median")), ("scale", StandardScaler())]), numeric))
+    if other:
+        transformers.append((
+            "categorical",
+            Pipeline([
+                ("fill", SimpleImputer(strategy="most_frequent")),
+                ("onehot", OneHotEncoder(handle_unknown="infrequent_if_exist", max_categories=MAX_ONE_HOT_CATEGORIES)),
+            ]),
+            other,
+        ))
+    return Pipeline([
+        ("prepare", ColumnTransformer(transformers, sparse_threshold=1.0)),
+        ("model", build_estimator(model_key, params, seed)),
+    ])
+
+
+def load_split(csv_path, target: str, test_size: float, seed: int):
+    """Read, check and split a dataset. Also used by the evaluation service to rebuild the test split."""
+    X, y = prepare(read_csv(csv_path), target)
+    return make_split(X, y, test_size, seed)
+
+
+def train(csv_path, target: str, model_key: str, params: dict, test_size: float, seed: int) -> TrainResult:
+    """Fit the selected model on the training split and return it with a few facts about the run."""
+    X_train, X_test, y_train, y_test = load_split(csv_path, target, test_size, seed)
+    pipe = build_pipeline(model_key, params, seed, X_train)
+    pipe.fit(X_train, y_train)
+    info = {
+        "n_train": int(len(X_train)),
+        "n_test": int(len(X_test)),
+        "n_features": int(X_train.shape[1]),
+        "classes": [str(c) for c in sorted(y_train.unique(), key=str)],
+    }
+    return TrainResult(pipeline=pipe, info=info)
