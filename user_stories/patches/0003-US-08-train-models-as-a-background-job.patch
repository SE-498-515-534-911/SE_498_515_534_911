+"""Finds the CSV file of a dataset.
+
+PLACEHOLDER CONTRACT. The real dataset storage belongs to the Data Workspace
+epic (US-01, Vikas). Training only needs one thing from it: the path of the
+user's CSV file. Point WBMME_DATASET_LOCATOR at a function with the signature
+
+    locate(user_id: int, dataset_id: int) -> pathlib.Path
+
+that raises `DatasetNotFound` when the user does not own that dataset. Because the
+user ID is part of the lookup, one user can never reach another user's file.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+from django.conf import settings
+from django.utils.module_loading import import_string
+
+DEFAULT_LOCATOR = "training.locator.default_locator"
+
+
+class DatasetNotFound(Exception):
+    pass
+
+
+def default_locator(user_id: int, dataset_id: int) -> Path:
+    """<WBMME_DATA_ROOT>/<user_id>/<dataset_id>.csv. Only integers go into the path."""
+    path = Path(settings.WBMME_DATA_ROOT) / str(int(user_id)) / f"{int(dataset_id)}.csv"
+    if not path.is_file():
+        raise DatasetNotFound(f"dataset {dataset_id} not found for user {user_id}")
+    return path
+
+
+def locate(user_id: int, dataset_id: int) -> Path:
+    func = import_string(getattr(settings, "WBMME_DATASET_LOCATOR", DEFAULT_LOCATOR))
+    return func(user_id, dataset_id)
