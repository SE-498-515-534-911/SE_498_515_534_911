diff --git a/training/tests/test_api_train.py b/training/tests/test_api_train.py
new file mode 100644
index 0000000..579add6
--- /dev/null
+++ b/training/tests/test_api_train.py
@@ -0,0 +1,178 @@
+import json
+
+import joblib
+import pytest
+
+from training import artifacts, jobs
+from training.models import TrainingRun
+
+from .conftest import write_csv
+
+pytestmark = pytest.mark.req("MLE-F-009")
+
+URL = "/api/train"
+
+
+def post(client, body, url=URL):
+    return client.post(url, data=json.dumps(body), content_type="application/json")
+
+
+def good(**over):
+    body = {"dataset_id": 1, "target": "label", "model": "logistic_regression"}
+    body.update(over)
+    return body
+
+
+def test_requires_login(client, dataset):
+    assert post(client, good()).status_code == 401
+
+
+def test_only_post(auth_client):
+    assert auth_client.get(URL).status_code == 405
+
+
+def test_training_completes_and_stores_artifact(auth_client, user, dataset):
+    r = post(auth_client, good(params={"C": 2.0}))
+    assert r.status_code == 202
+    body = r.json()
+    assert body["status_url"] == f"/api/train/{body['run_id']}"
+    run = TrainingRun.objects.get(pk=body["run_id"])
+    assert run.status == "completed"
+    assert run.params == {"C": 2.0, "max_iter": 200}
+    assert run.started_at and run.finished_at and run.duration_seconds is not None
+    path = artifacts.artifact_path(user.pk, run.pk)
+    assert path.is_file()
+    assert hasattr(joblib.load(path), "predict")
+
+
+def test_status_endpoint(auth_client, dataset):
+    run_id = post(auth_client, good()).json()["run_id"]
+    r = auth_client.get(f"/api/train/{run_id}")
+    assert r.status_code == 200
+    data = r.json()
+    assert data["status"] == "completed" and data["model"] == "logistic_regression"
+    assert data["error"] is None and data["seed"] == 42 and data["test_size"] == 0.2
+
+
+def test_status_is_owner_only(client, user, other_user, dataset):
+    client.force_login(user)
+    run_id = post(client, good()).json()["run_id"]
+    client.force_login(other_user)
+    assert client.get(f"/api/train/{run_id}").status_code == 404
+    assert client.get("/api/train/99999").status_code == 404
+
+
+def test_cannot_train_on_another_users_dataset(client, other_user, dataset):
+    client.force_login(other_user)
+    r = post(client, good())
+    assert r.status_code == 404
+    assert r.json()["error"] == "dataset_not_found"
+    assert TrainingRun.objects.count() == 0
+
+
+def test_bad_data_marks_run_failed_with_friendly_message(auth_client, dataset):
+    r = post(auth_client, good(target="missing_col"))
+    assert r.status_code == 202
+    run = TrainingRun.objects.get()
+    assert run.status == "failed"
+    assert "not in the dataset" in run.error_message
+
+
+def test_internal_error_is_not_leaked(auth_client, dataset, monkeypatch):
+    def boom(*a, **k):
+        raise RuntimeError("secret /srv/path detail")
+
+    monkeypatch.setattr(jobs.pipeline, "train", boom)
+    post(auth_client, good())
+    run = TrainingRun.objects.get()
+    assert run.status == "failed"
+    assert run.error_message == jobs.GENERIC_FAILURE
+    assert "secret" not in run.error_message
+
+
+def test_failed_run_leaves_no_artifact(auth_client, user, dataset):
+    post(auth_client, good(target="missing_col"))
+    run = TrainingRun.objects.get()
+    assert not artifacts.artifact_path(user.pk, run.pk).exists()
+
+
+def test_dataset_removed_before_job_runs(auth_client, user, dataset, settings):
+    run = TrainingRun.objects.create(owner=user, dataset_id=77, target="label", model_key="knn", params={})
+    jobs.execute_run(run.pk)
+    run.refresh_from_db()
+    assert run.status == "failed" and "could not be found" in run.error_message
+
+
+def test_job_runs_in_a_separate_thread(auth_client, dataset, settings, monkeypatch):
+    settings.WBMME_JOBS_INLINE = False
+    started = []
+
+    class FakeThread:
+        def __init__(self, target, args, name, daemon):
+            started.append((target, args, daemon))
+
+        def start(self):
+            pass
+
+    monkeypatch.setattr(jobs.threading, "Thread", FakeThread)
+    r = post(auth_client, good())
+    assert r.status_code == 202
+    assert r.json()["status"] == "queued"
+    assert started and started[0][2] is True
+
+
+@pytest.mark.parametrize("override, field", [
+    ({"dataset_id": 0}, "dataset_id"),
+    ({"dataset_id": "1"}, "dataset_id"),
+    ({"dataset_id": True}, "dataset_id"),
+    ({"target": ""}, "target"),
+    ({"target": 5}, "target"),
+    ({"target": "x" * 201}, "target"),
+    ({"model": "svm"}, "model"),
+    ({"params": {"C": 1000}}, "params.C"),
+    ({"test_size": 0.07}, "test_size"),
+    ({"test_size": 0.55}, "test_size"),
+    ({"test_size": "0.2"}, "test_size"),
+    ({"seed": -1}, "seed"),
+    ({"seed": 1.5}, "seed"),
+])
+def test_invalid_requests(auth_client, dataset, override, field):
+    r = post(auth_client, good(**override))
+    assert r.status_code == 400
+    body = r.json()
+    assert body["error"] == "invalid_request"
+    assert field in [d["field"] for d in body["details"]]
+    assert TrainingRun.objects.count() == 0
+
+
+def test_invalid_json(auth_client):
+    r = auth_client.post(URL, data="{nope", content_type="application/json")
+    assert r.status_code == 400
+
+
+@pytest.mark.parametrize("ts", [0.1, 0.15, 0.2, 0.35, 0.5])
+def test_valid_test_sizes(auth_client, dataset, ts):
+    assert post(auth_client, good(test_size=ts)).status_code == 202
+
+
+def test_same_seed_gives_same_predictions(auth_client, user, dataset):
+    ids = [post(auth_client, good(model="random_forest", seed=5)).json()["run_id"] for _ in range(2)]
+    import pandas as pd
+    from training import pipeline
+    from django.conf import settings
+    csv = settings.WBMME_DATA_ROOT / str(user.pk) / "1.csv"
+    X_test = pipeline.load_split(csv, "label", 0.2, 5)[1]
+    p = [joblib.load(artifacts.artifact_path(user.pk, i)).predict(X_test) for i in ids]
+    assert (p[0] == p[1]).all()
+
+
+def test_artifact_write_is_atomic(user, tmp_path, settings, monkeypatch):
+    def broken(obj, path):
+        path.write_bytes(b"partial")
+        raise OSError("disk full")
+
+    monkeypatch.setattr(joblib, "dump", broken)
+    with pytest.raises(OSError):
+        artifacts.save({"x": 1}, user.pk, 9)
+    assert not artifacts.artifact_path(user.pk, 9).exists()
+    assert not list(artifacts.user_dir(user.pk).glob("*.tmp"))
