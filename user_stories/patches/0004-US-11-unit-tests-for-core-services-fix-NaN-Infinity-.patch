+"""US-11: unit tests of the core services in isolation (no HTTP).
+
+Each class targets one service and checks its rules directly, so a failure
+points at the service rather than at the API in front of it.
+"""
+import pytest
+
+from training import artifacts, jobs, locator, schemas
+from training.http import BadJson, parse_json_object
+from training.models import TrainingRun
+
+pytestmark = pytest.mark.req("MLE-F-007", "MLE-F-008", "MLE-F-009")
+
+
+class TestTrainRequestSchema:
+    base = {"dataset_id": 1, "target": "y", "model": "knn"}
+
+    def test_defaults(self):
+        req, errors = schemas.parse_train_request(dict(self.base))
+        assert errors == []
+        assert (req.test_size, req.seed) == (0.2, 42)
+        assert req.params == {"n_neighbors": 5, "weights": "uniform"}
+
+    def test_all_errors_reported_together(self):
+        _, errors = schemas.parse_train_request({"dataset_id": 0, "target": "", "model": "x", "seed": -1})
+        assert {e["field"] for e in errors} == {"dataset_id", "target", "model", "seed"}
+
+    @pytest.mark.parametrize("v", [0.1, 0.15, 0.5, 0.25, 0.3])
+    def test_good_test_sizes(self, v):
+        assert schemas._valid_test_size(v)
+
+    @pytest.mark.parametrize("v", [0.05, 0.12, 0.55, 1, 0, True, "0.2", None, float("nan"), float("inf"), -float("inf")])
+    def test_bad_test_sizes(self, v):
+        assert not schemas._valid_test_size(v)
+
+    def test_seed_boundaries(self):
+        assert schemas.parse_train_request({**self.base, "seed": 0})[1] == []
+        assert schemas.parse_train_request({**self.base, "seed": schemas.MAX_SEED})[1] == []
+        assert schemas.parse_train_request({**self.base, "seed": schemas.MAX_SEED + 1})[1] != []
+
+
+class TestLocator:
+    def test_finds_own_file(self, settings, user, dataset):
+        assert locator.locate(user.pk, dataset).name == "1.csv"
+
+    def test_other_user_cannot_locate(self, other_user, dataset):
+        with pytest.raises(locator.DatasetNotFound):
+            locator.locate(other_user.pk, dataset)
+
+    def test_missing_dataset(self, user):
+        with pytest.raises(locator.DatasetNotFound):
+            locator.locate(user.pk, 12345)
+
+    def test_custom_locator_setting(self, settings, user, tmp_path):
+        settings.WBMME_DATASET_LOCATOR = "training.tests.test_services_unit.fake_locator"
+        assert locator.locate(user.pk, 3) == tmp_path / "fake.csv"
+
+
+def fake_locator(user_id, dataset_id):
+    from django.conf import settings
+
+    return settings.WBMME_DATA_ROOT.parent / "fake.csv"
+
+
+class TestArtifacts:
+    def test_paths_are_per_user(self, user, other_user):
+        a, b = artifacts.artifact_path(user.pk, 1), artifacts.artifact_path(other_user.pk, 1)
+        assert a != b and a.parent != b.parent
+
+    def test_path_is_built_from_integers_only(self, user):
+        p = artifacts.artifact_path(user.pk, "7")
+        assert p.name == "run_7.joblib"
+        with pytest.raises(ValueError):
+            artifacts.artifact_path(user.pk, "../../etc/passwd")
+
+    def test_round_trip(self, user):
+        import joblib
+
+        path = artifacts.save({"k": [1, 2]}, user.pk, 4)
+        assert joblib.load(path) == {"k": [1, 2]}
+
+    def test_overwrite_replaces_old_file(self, user):
+        import joblib
+
+        artifacts.save("old", user.pk, 4)
+        artifacts.save("new", user.pk, 4)
+        assert joblib.load(artifacts.artifact_path(user.pk, 4)) == "new"
+
+
+class TestTrainingRunModel:
+    def make(self, user, **kw):
+        return TrainingRun.objects.create(owner=user, dataset_id=1, target="y", model_key="knn", **kw)
+
+    def test_defaults(self, user):
+        run = self.make(user)
+        assert run.status == "queued" and run.duration_seconds is None
+        assert "knn" in str(run) and "queued" in str(run)
+
+    def test_duration(self, user):
+        from datetime import timedelta
+        from django.utils import timezone
+
+        run = self.make(user)
+        run.started_at = timezone.now()
+        run.finished_at = run.started_at + timedelta(seconds=2.5)
+        assert run.duration_seconds == 2.5
+        assert run.as_dict()["duration_seconds"] == 2.5
+
+    def test_newest_first(self, user):
+        a, b = self.make(user), self.make(user)
+        assert list(TrainingRun.objects.all()) == [b, a]
+
+    def test_deleting_user_deletes_runs(self, user):
+        self.make(user)
+        user.delete()
+        assert TrainingRun.objects.count() == 0
+
+
+class TestJobs:
+    def test_unknown_run_is_ignored(self, db):
+        jobs.execute_run(424242)  # must not raise
+
+    def test_thread_entry_runs_the_job(self, user, dataset, monkeypatch):
+        calls = []
+        monkeypatch.setattr(jobs, "execute_run", calls.append)
+        monkeypatch.setattr(jobs, "close_old_connections", lambda: calls.append("close"))
+        jobs._thread_main(5)
+        assert calls == ["close", 5, "close"]
+
+    def test_thread_entry_closes_connections_even_on_error(self, monkeypatch):
+        calls = []
+
+        def boom(_):
+            raise RuntimeError
+
+        monkeypatch.setattr(jobs, "execute_run", boom)
+        monkeypatch.setattr(jobs, "close_old_connections", lambda: calls.append("close"))
+        with pytest.raises(RuntimeError):
+            jobs._thread_main(5)
+        assert calls == ["close", "close"]
+
+    def test_status_sequence(self, user, dataset, monkeypatch):
+        seen = []
+        real = jobs.pipeline.train
+
+        def spy(*a, **k):
+            seen.append(TrainingRun.objects.get().status)
+            return real(*a, **k)
+
+        monkeypatch.setattr(jobs.pipeline, "train", spy)
+        run = TrainingRun.objects.create(owner=user, dataset_id=dataset, target="label", model_key="decision_tree", params={})
+        jobs.execute_run(run.pk)
+        run.refresh_from_db()
+        assert seen == ["running"] and run.status == "completed"
+
+
+class TestJsonBody:
+    class Req:
+        def __init__(self, body, ctype="application/json"):
+            self.body, self.content_type = body, ctype
+
+    def test_object_ok(self):
+        assert parse_json_object(self.Req(b'{"a": 1}')) == {"a": 1}
+
+    @pytest.mark.parametrize("raw", [b"[1]", b"3", b"null", b"{bad", b"\xff\xfe"])
+    def test_rejects_non_objects(self, raw):
+        with pytest.raises(BadJson):
+            parse_json_object(self.Req(raw))
