 """Validation of the POST /api/train request body (SRS MLE-F-006, MLE-F-007, MLE-F-008)."""
 from __future__ import annotations
 
+import math
 from dataclasses import dataclass
 
 from . import catalogue
@@ -30,6 +31,8 @@ def _valid_test_size(v) -> bool:
     """10% to 50% in steps of 5% (MLE-F-006)."""
     if isinstance(v, bool) or not isinstance(v, (int, float)):
         return False
+    if not math.isfinite(v):  # JSON allows NaN and Infinity
+        return False
     steps = v * 20
     return abs(steps - round(steps)) < 1e-9 and 2 <= round(steps) <= 10
 
