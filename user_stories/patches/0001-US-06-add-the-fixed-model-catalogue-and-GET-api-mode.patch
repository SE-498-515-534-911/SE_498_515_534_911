+"""DEV ONLY helpers. Not part of the product; replaced by US-15 (login)."""
+import json
+
+from django.contrib.auth import authenticate, login, logout
+from django.http import JsonResponse
+from django.views.decorators.csrf import csrf_exempt
+from django.views.decorators.http import require_POST
+
+
+@csrf_exempt
+@require_POST
+def dev_login(request):
+    try:
+        data = json.loads(request.body or b"{}")
+    except ValueError:
+        return JsonResponse({"error": "bad_request", "message": "Body must be JSON."}, status=400)
+    user = authenticate(request, username=data.get("username"), password=data.get("password"))
+    if user is None:
+        return JsonResponse({"error": "invalid_credentials", "message": "Invalid username or password."}, status=401)
+    login(request, user)
+    return JsonResponse({"ok": True})
+
+
+@csrf_exempt
+@require_POST
+def dev_logout(request):
+    logout(request)
+    return JsonResponse({"ok": True})
