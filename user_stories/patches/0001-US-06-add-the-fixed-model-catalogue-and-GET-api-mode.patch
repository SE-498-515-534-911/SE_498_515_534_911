+"""Training API views (SAD 3.4: API Gateway & Controllers delegate to services)."""
+from django.http import JsonResponse
+from django.views.decorators.http import require_GET
+
+from . import catalogue
+from .http import api_login_required
+
+
+@require_GET
+@api_login_required
+def list_models(request):
+    """GET /api/models: the model catalogue with defaults and permitted ranges (MLE-F-007)."""
+    return JsonResponse({"models": [m.describe() for m in catalogue.list_models()]})
