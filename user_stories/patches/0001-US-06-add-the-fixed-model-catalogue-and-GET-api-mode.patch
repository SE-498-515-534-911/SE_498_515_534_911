+import pytest
+
+pytestmark = pytest.mark.req("MLE-F-007")
+
+
+@pytest.mark.django_db
+def test_models_endpoint_requires_login(client):
+    response = client.get("/api/models")
+    assert response.status_code == 401
+    assert response.json()["error"] == "not_authenticated"
+
+
+@pytest.mark.django_db
+def test_models_endpoint_lists_the_catalogue_with_defaults(auth_client):
+    response = auth_client.get("/api/models")
+    assert response.status_code == 200
+    models = response.json()["models"]
+    assert len(models) == 4
+    rf = next(m for m in models if m["key"] == "random_forest")
+    assert rf["defaults"] == {"n_estimators": 100, "max_depth": None}
+    assert {p["name"] for p in rf["params"]} == {"n_estimators", "max_depth"}
+
+
+@pytest.mark.django_db
+def test_models_endpoint_rejects_post(auth_client):
+    assert auth_client.post("/api/models").status_code == 405
