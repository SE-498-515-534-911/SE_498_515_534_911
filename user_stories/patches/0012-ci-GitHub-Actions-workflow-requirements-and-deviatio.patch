diff --git a/.github/workflows/member2-tests.yml b/.github/workflows/member2-tests.yml
new file mode 100644
index 0000000..26410db
--- /dev/null
+++ b/.github/workflows/member2-tests.yml
@@ -0,0 +1,26 @@
+name: Member 2 tests
+
+# Runs the unit, integration and system tests for training, limits and the speed benchmark
+# whenever one of Member 2's folders changes, on every pull request and push to main.
+on:
+  pull_request:
+    paths: ["training/**", "member2_dev/**", "loadtest/**", ".github/workflows/member2-tests.yml"]
+  push:
+    branches: [main]
+    paths: ["training/**", "member2_dev/**", "loadtest/**"]
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+          cache: pip
+          cache-dependency-path: member2_dev/requirements.txt
+      - run: pip install -r member2_dev/requirements.txt
+      - name: Unit, integration and system tests (with coverage)
+        run: python -m pytest -c member2_dev/pytest.ini --cov=training --cov-report=term-missing --cov-fail-under=95
+      - name: Training speed target (MLE-NF-002)
+        run: python -m pytest -c member2_dev/pytest.ini -m perf
