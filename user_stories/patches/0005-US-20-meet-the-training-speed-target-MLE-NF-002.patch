+# Tree models are several times slower on sparse input (a 50,000 x 20 benchmark:
+# 66 s sparse against 12 s dense for a random forest), so features are dense by
+# default. Only a very wide table falls back to sparse, to protect server memory.
+MAX_DENSE_CELLS = 60_000_000  # about 480 MB of float64
 
 
 class DataError(Exception):
@@ -80,6 +84,19 @@ def make_split(X, y, test_size: float, seed: int):
         ) from None
 
 
+def estimated_width(X_train) -> int:
+    """Upper bound of the number of columns after preparation."""
+    numeric = X_train.select_dtypes(include="number").columns
+    width = len(numeric)
+    for col in X_train.columns.difference(numeric):
+        width += min(int(X_train[col].nunique(dropna=True)) + 1, MAX_ONE_HOT_CATEGORIES)
+    return width
+
+
+def use_dense(X_train) -> bool:
+    return len(X_train) * estimated_width(X_train) <= MAX_DENSE_CELLS
+
+
