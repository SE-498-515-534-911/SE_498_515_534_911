+"""US-20 / MLE-NF-002. Slow, so it only runs with:  pytest -m perf"""
+import pytest
+
+from training.benchmarks import speed
+
+pytestmark = [pytest.mark.perf, pytest.mark.req("MLE-NF-002")]
+
+
+def test_dataset_has_required_shape():
+    df = speed.make_dataset(1000)
+    assert df.shape == (1000, 21)  # 20 features + target
+    assert df["target"].nunique() == 3
+    assert df.isna().any().any()
+
+
+def test_dataset_is_reproducible():
+    assert speed.make_dataset(500).equals(speed.make_dataset(500))
+
+
+def test_every_default_model_trains_within_the_limit():
+    results = speed.run()
+    slow = [r for r in results if not r["passed"]]
+    assert not slow, slow
