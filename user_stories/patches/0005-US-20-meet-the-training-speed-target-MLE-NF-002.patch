@@ -0,0 +1,82 @@
+"""Training-speed benchmark (US-20, MLE-NF-002).
+
+Requirement: with a 50,000-row, 20-column dataset, every model in the catalogue
+trains with its DEFAULT settings in at most 60 seconds.
+
+The dataset is synthetic and fixed by a seed, so every run measures the same
+work: 15 numeric features (3 with missing values) and 5 text features, with a
+3-class target that depends on some of the features.
+
+Run:  python -I member2_dev/../training/benchmarks/speed.py   (or via pytest -m perf)
+"""
+from __future__ import annotations
+
+import json
+import platform
+import sys
+import time
+from pathlib import Path
+
+LIMIT_SECONDS = 60.0
+ROWS = 50_000
+NUMERIC = 15
+TEXT = 5
+
+
+def make_dataset(rows: int = ROWS, seed: int = 0):
+    import numpy as np
+    import pandas as pd
+
+    rng = np.random.default_rng(seed)
+    data = {f"num_{i}": rng.normal(size=rows) for i in range(NUMERIC)}
+    for i in range(TEXT):
+        data[f"cat_{i}"] = rng.choice([f"v{j}" for j in range(8)], rows)
+    df = pd.DataFrame(data)
+    score = df["num_0"] + 0.5 * df["num_1"] - 0.5 * df["num_2"] + (df["cat_0"] == "v1") + rng.normal(scale=0.5, size=rows)
+    df["target"] = np.digitize(score, np.quantile(score, [1 / 3, 2 / 3])).astype(str)
+    for col in ("num_3", "num_4", "num_5"):
+        df.loc[rng.random(rows) < 0.05, col] = np.nan
+    return df
+
+
+def run(csv_path: Path | None = None, rows: int = ROWS) -> list[dict]:
+    """Time every catalogue model. Returns one dict per model."""
+    import tempfile
+
+    from training import pipeline
+    from training.catalogue import list_models
+
+    df = make_dataset(rows)
+    with tempfile.TemporaryDirectory() as tmp:
+        path = Path(tmp) / "bench.csv" if csv_path is None else csv_path
+        df.to_csv(path, index=False)
+        results = []
+        for spec in list_models():
+            start = time.perf_counter()
+            pipeline.train(path, "target", spec.key, spec.defaults(), 0.2, 42)
+            seconds = time.perf_counter() - start
+            results.append({
+                "model": spec.key,
+                "seconds": round(seconds, 2),
+                "limit": LIMIT_SECONDS,
+                "passed": seconds <= LIMIT_SECONDS,
+            })
+    return results
+
+
+def main() -> int:
+    import os
+
+    here = Path(__file__).resolve()
+    sys.path.insert(0, str(here.parents[2]))
+    results = run()
+    report = {
+        "rows": ROWS, "columns": NUMERIC + TEXT, "python": platform.python_version(),
+        "machine": platform.platform(), "cpus": os.cpu_count(), "results": results,
+    }
+    print(json.dumps(report, indent=2))
+    return 0 if all(r["passed"] for r in results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
