@@ -80,3 +80,25 @@ def test_unreadable_csv(tmp_path):
     path.write_bytes(b"")
     with pytest.raises(pipeline.DataError, match="could not be read"):
         pipeline.read_csv(path)
+
+
+def test_features_are_dense_for_normal_sized_data(iris_like):
+    X, y = pipeline.prepare(iris_like, "label")
+    pipe = pipeline.build_pipeline("random_forest", {}, 1, X)
+    out = pipe.named_steps["prepare"].fit_transform(X)
+    assert isinstance(out, np.ndarray)
+
+
+def test_very_wide_data_falls_back_to_sparse(iris_like, monkeypatch):
+    from scipy import sparse
+
+    monkeypatch.setattr(pipeline, "MAX_DENSE_CELLS", 10)
+    X, y = pipeline.prepare(iris_like, "label")
+    assert not pipeline.use_dense(X)
+    out = pipeline.build_pipeline("logistic_regression", {}, 1, X).named_steps["prepare"].fit_transform(X)
+    assert sparse.issparse(out)
+
+
+def test_estimated_width_caps_categories():
+    df = pd.DataFrame({"n": range(100), "c": [f"v{i}" for i in range(100)]})
+    assert pipeline.estimated_width(df) == 1 + pipeline.MAX_ONE_HOT_CATEGORIES
